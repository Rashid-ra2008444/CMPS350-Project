generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  Int
  status    String // "admin", "student", or "instructor"
  studentId Int?     @unique
  student   Student?
}

model Student {
  studentId   Int          @id @default(autoincrement())
  user        User?        @relation(fields: [studentId], references: [studentId], onUpdate: Cascade, onDelete: Cascade)
  enrollments Enrollment[] // One Student can have Many Enrollments
}

model Course {
  id                 Int          @id @default(autoincrement())
  name               String
  courseNum          Int
  instructor         String
  prerequisite       String       @default("none")
  enrollment_maximum Int          @default(30)
  enrollment_actual  Int          @default(0)
  category           String // "CMPS", "CMPE", "MATH", "GENG"
  status             String // "valid", "pending", "invalid"
  crn                Int          @unique
  enrollments        Enrollment[]
}

model Enrollment {
  studentId      Int
  studentName    String
  courseNum      Int
  crn            Int
  instructor     String
  enrollmentDate String
  grade          String?
  courseStatus   String?

  // Relations
  course  Course  @relation(fields: [crn], references: [crn], onUpdate: Cascade, onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [studentId], onUpdate: Cascade, onDelete: Cascade)

  @@id([studentId, crn]) // Composite primary key
}
